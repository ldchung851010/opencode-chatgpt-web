{
  "$schema": "https://opencode.ai/config.json",
  "model": "chatgpt-web/gpt-5.6-sol",
  "provider": {
    "chatgpt-web": {
      "name": "ChatGPT Web (local bridge)",
      "npm": "@ai-sdk/openai",
      "api": "http://127.0.0.1:17841/v1",
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol via ChatGPT Web",
          "tool_call": true,
          "limit": {
            "context": 90000,
            "output": 16000
          },
          "variants": {
            "instant": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "extra-high": { "reasoningEffort": "xhigh" },
            "pro": { "reasoningEffort": "max" }
          }
        }
      },
      "options": {
        "apiKey": "local-chatgpt-web",
        "baseURL": "http://127.0.0.1:17841/v1"
      }
    }
  }
}
